# Copy this file to .env and replace every placeholder with a fresh secret.
# Never commit .env or place production credentials in source control.

PROJECT_NAME=fileserver
APP_PORT=8080

DB_NAME=fileserver
DB_USER=fileserver
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD

REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_REDIS_PASSWORD

# Generate independent random values. Do not reuse these across environments.
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_BYTES
MASTER_KEY=REPLACE_WITH_A_SECRET_MASTER_KEY

APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_INITIAL_ADMIN_PASSWORD
APP_ADMIN_NAME=Admin

TELEGRAM_STORAGE_BOT_TOKEN=REPLACE_WITH_ROTATED_TELEGRAM_STORAGE_BOT_TOKEN
TELEGRAM_STORAGE_CHAT_ID=REPLACE_WITH_TELEGRAM_STORAGE_CHAT_ID

# Optional operational logging bot. Disabled unless explicitly enabled.
TELEGRAM_LOGGER_ENABLED=false
TELEGRAM_LOGGER_BOT_TOKEN=
TELEGRAM_LOGGER_CHAT_ID=

# Google OAuth credentials for this exact application/client.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET

# Email is disabled by default; configure both values before enabling.
APP_EMAIL_ENABLED=false
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
